# Due server environment. Placeholders only: never commit real values.
NODE_ENV=production
PORT=10000
# Postgres 16 connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# At least 32 random characters (used to key session-token hashes).
SESSION_SECRET=replace-with-at-least-32-random-characters
# One-time token for POST /api/auth/setup. Remove it after the first owner exists.
ADMIN_SETUP_TOKEN=
# Public consumer app origin(s) allowed to call /api/public/* (comma-separated).
PUBLIC_APP_ORIGIN=https://app.example.invalid
# Public base URL of this server (used for links and the Origin check).
PUBLIC_BASE_URL=https://admin.example.invalid
# true on exactly the service that should run scheduled jobs.
RUN_SCHEDULER=false
# Optional: SMTP connection URL for important-alert emails. Without it alerts are in-app only.
SMTP_URL=
# Optional: sender address for alert emails.
SMTP_FROM=
# Optional: trust X-Forwarded-* from the platform proxy (default true in production).
TRUST_PROXY=
