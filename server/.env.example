# Due server environment. Placeholders only: never commit real values.
NODE_ENV=production
PORT=10000
# Postgres 16 connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# At least 32 random characters (used to key session-token hashes).
SESSION_SECRET=replace-with-at-least-32-random-characters
# One-time token for POST /api/auth/setup. Remove it after the first owner exists.
ADMIN_SETUP_TOKEN=
# Public consumer app origin(s) allowed to call /api/public/* (comma-separated).
PUBLIC_APP_ORIGIN=https://app.example.invalid
# Public base URL of this server (used for links and the Origin check).
PUBLIC_BASE_URL=https://admin.example.invalid
# true on exactly the service that should run scheduled jobs.
RUN_SCHEDULER=false
# Optional: SMTP connection URL for important-alert emails, consumer sign-in links, household invites and
# email reminders. Without it alerts are in-app only and consumer sign-in returns 503 email_unavailable.
SMTP_URL=
# Optional: sender address for alert emails.
SMTP_FROM=
# Optional: trust X-Forwarded-* from the platform proxy (default true in production).
TRUST_PROXY=
# Optional: Razorpay Subscriptions. Checkout returns 503 payments_unavailable unless all three are set
# AND the plan's Razorpay plan ids are entered in the admin (Plans). Webhook URL: /api/billing/razorpay/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: forwarded-email intake. Aliases look like u84kd@<INBOUND_EMAIL_DOMAIN>. Intake reports live:false
# until both are set. Configure Postmark (inbound JSON, basic auth password = secret) or Mailgun (routes,
# signing key = secret) to POST to /api/inbound/email.
INBOUND_EMAIL_DOMAIN=
INBOUND_WEBHOOK_SECRET=
# Optional: 32 random bytes, base64 (openssl rand -base64 32). Encrypts raw intake text at rest (AES-256-GCM).
# Without it the server stores structured fields only and never keeps raw message text.
DATA_ENCRYPTION_KEY=
