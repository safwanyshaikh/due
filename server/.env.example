# Due server environment. Placeholders only: never commit real values.
NODE_ENV=production
PORT=10000
# Postgres 16 connection string.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# At least 32 random characters (used to key session-token hashes).
SESSION_SECRET=replace-with-at-least-32-random-characters
# One-time token for POST /api/auth/setup. Remove it after the first owner exists.
ADMIN_SETUP_TOKEN=
# Public consumer app origin(s) allowed to call /api/public/* (comma-separated).
PUBLIC_APP_ORIGIN=https://app.example.invalid
# Public base URL of this server (used for links and the Origin check).
PUBLIC_BASE_URL=https://admin.example.invalid
# true on exactly the service that should run scheduled jobs.
RUN_SCHEDULER=false
# Optional: SMTP connection URL for important-alert emails, consumer sign-in links, household invites and
# email reminders. Without it alerts are in-app only and consumer sign-in returns 503 email_unavailable.
SMTP_URL=
# Optional: sender address for alert emails.
SMTP_FROM=
# Number of reverse-proxy hops whose X-Forwarded-For entries are trusted (default 1 in production = Render's
# proxy, 0 elsewhere). Never more than the real number of proxies in front of the server.
TRUST_PROXY_HOPS=
# Optional: header the platform proxy always overwrites with the client IP (e.g. cf-connecting-ip). Leave empty
# unless the platform documents it; see docs/production/SECURITY.md ("Client IP") for how to verify the hops.
CLIENT_IP_HEADER=
# Optional: comma-separated IPs/CIDRs allowed to reach /admin, /api/admin and /api/auth (others get 404).
ADMIN_ALLOWED_IPS=
# Optional: HTTPS endpoint in an India region (e.g. AWS ap-south-1 -> S3 with Object Lock) that receives redacted
# logs and audit rows as NDJSON, and its bearer token. See docs/production/INCIDENT_RESPONSE.md.
LOG_SINK_URL=
LOG_SINK_TOKEN=
# Optional: Razorpay Subscriptions. Checkout returns 503 payments_unavailable unless all three are set
# AND the plan's Razorpay plan ids are entered in the admin (Plans). Webhook URL: /api/billing/razorpay/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Payment gateway: razorpay (default) or cashfree. Webhook URL for Cashfree: /api/billing/webhook/cashfree
BILLING_PROVIDER=razorpay
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Only if Cashfree issues a separate webhook secret; otherwise the secret key signs webhooks.
CASHFREE_WEBHOOK_SECRET=
# sandbox | production
CASHFREE_ENV=sandbox
# Optional: forwarded-email intake. Aliases look like u84kd@<INBOUND_EMAIL_DOMAIN>. Intake reports live:false
# until both are set. Configure Postmark (inbound JSON, basic auth password = secret) or Mailgun (routes,
# signing key = secret) to POST to /api/inbound/email.
INBOUND_EMAIL_DOMAIN=
INBOUND_WEBHOOK_SECRET=
# REQUIRED in production: 32 random bytes, base64 (openssl rand -base64 32), or a key ring "kid:key,oldkid:key"
# (first = current). Encrypts synced backups, raw intake text, held inbound mail and Gmail excerpts (AES-256-GCM).
DATA_ENCRYPTION_KEY=
# Optional: read-only Gmail connection (scope gmail.readonly + openid email). All four are required, otherwise
# GET /api/account/gmail/status reports mode 'not_configured' and connect returns 503. See docs/production/GOOGLE_VERIFICATION.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must equal the redirect URI registered in Google Cloud exactly: https://<host>/api/account/gmail/callback
GOOGLE_REDIRECT_URI=
# Token encryption keys "kid:base64(32 bytes),oldkid:base64(32 bytes)"; the first is current (rotation).
GMAIL_TOKEN_KEYS=
# test (Google app in Testing, test users only; default) | verification_pending | live
GMAIL_OAUTH_MODE=
# Optional: Sentry-compatible DSN. Reports carry only error type, redacted message, stack locations and the
# correlation id (no request bodies, users, mail/document content or amounts).
SENTRY_DSN=
# Web service only: also run the queue worker in-process (single-service setups). Normally the due-worker
# service (npm --prefix server run worker) processes the queue; /health/ready fails without a worker heartbeat.
RUN_QUEUE_WORKER=
# Worker only: parallel queue claim loops (default 2).
QUEUE_CONCURRENCY=
# Optional: encrypted backups (server/scripts/backup.sh, restore.sh, npm run backup:verify). Keep the key in a
# password manager / secret store, never next to the backups.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
