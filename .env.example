# Placeholders only. Never commit real values.

# Consumer app (Vite, exposed to the browser bundle — never put secrets here).
# Base URL of Due's API, without a trailing slash. Leave empty when the app is served from the
# same origin as the API (requests then go to /api/public/catalog on the same host).
# Example: VITE_API_BASE=https://api.your-domain.example
VITE_API_BASE=

# Server-side settings (DATABASE_URL, SESSION_SECRET, ADMIN_SETUP_TOKEN, ...) are documented in
# docs/production/ and must never be prefixed with VITE_.

